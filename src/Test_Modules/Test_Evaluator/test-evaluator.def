Bootstrap: docker
From: python:3.13-slim
Stage: build

%files
    ./config.py /Test_Evaluator/config.py
    ./data_loader.py /Test_Evaluator/data_loader.py
    ./evaluator_content_handler.py /Test_Evaluator/evaluator_content_handler.py
    ./evaluator_metrics_calculator.py /Test_Evaluator/evaluator_metrics_calculator.py
    ./evaluator_RestAPI.py /Test_Evaluator/evaluator_RestAPI.py

%environment
    export APPTAINER_NO_MOUNT="home,tmp,proc,sys,dev"
    export LC_ALL=C
    
%post
    # Install system packages and dependencies
    echo "Installing system dependencies..."
    apt-get update && \
    apt-get install -y --no-install-recommends python3-pip bzip2 ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

    echo "Installing Python dependencies..."
    python -m pip install --upgrade pip
    python -m pip install --no-cache-dir numpy tqdm pandas msgpack requests
    
    # Set permissions to access all directories
    echo "Setting permissions for directories and script..."
    chmod -R 755 /Test_Evaluator

%runscript
    exec python3 /Test_Evaluator/evaluator_RestAPI.py "$@"

%startscript
    exec python3 /Test_Evaluator/evaluator_RestAPI.py "$@"

%labels
    Authors "Satyam Priyadarshi"
    game_schema_version "1.0"
    Description "This is a sample evaluator container for testing the Evaluator API. It includes dummy evaluation metrics and serves as a template for building custom evaluators."

%help
    This is a container for a sample evaluator. It includes:
    - Evaluator API script
    - Evaluator utility script with helper functions.
    - Dummy evaluation -- Pearson r and cell-type specificity.
    
    Run the container by binding these directories and run the container:
    ```bash
    apptainer run \
      -B absolute/path/to/evaluator_data:/evaluator_data \
      -B absolute/path/to/predictions:/predictions \
      test-evaluator.sif PREDICTOR_HOST PREDICTOR_PORT /predictions
    ```

    NOTE: The file inside `evaluator_data/` must be titled "test_evaluator_request.json" for the script to read the input file. 