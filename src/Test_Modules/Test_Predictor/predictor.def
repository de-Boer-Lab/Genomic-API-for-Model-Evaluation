Bootstrap: docker
From: python:3.13-slim
Stage: build

%files
    ../Test_Predictor /Test_Predictor

%environment
    export APPTAINER_NO_MOUNT="home,tmp,proc,sys,dev"
    export LC_ALL=C
    # export PATH="/opt/conda/bin:$PATH"
    # export LD_LIBRARY_PATH="/opt/conda/lib:$LD_LIBRARY_PATH"

%post
    # Install system packages needed for conda and building extensions
    echo "Installing system dependencies..."
    apt-get update && \
    apt-get install -y --no-install-recommends python3-pip bzip2 ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Set permissions for copied files
    echo "Setting permissions..."
    chmod -R 755 /Test_Predictor

    echo "Installing Python dependencies..."
    python -m pip install --upgrade pip
    pip3 install --no-cache-dir numpy pandas tqdm msgpack flask

%runscript
    exec python3 /Test_Predictor/predictor_RestAPI.py "$@"

%startscript
    exec python3 /Test_Predictor/predictor_RestAPI.py "$@"

%labels
    test_predictor_deBoer
    Author "Satyam Priyadarshi and Ishika Luthra"

%help
    This is a container for a sample predictor. It includes:
    - Predictor script for sequence processing and error handling.
    - Script for `deBoerTest_model`, which is integrated into the predictor as the dummy model.
    - Support scripts like `api_preprocessing_utils.py`, `error_message_functions_updated.py`, and `predictor_help_message.json`.
    
    Run the container
    ```
    apptainer run --containall test_predictor.sif HOST PORT
    ```